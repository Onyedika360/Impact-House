# ── DATABASE ──────────────────────────────────────────
# Get this from https://neon.tech (free PostgreSQL hosting)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── AUTH ───────────────────────────────────────────────
# Generate a strong random secret: run  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── CLERK ───────────────────────────────────────────────
# Comma-separated Clerk user IDs allowed to access this app
# Find your user ID at: https://dashboard.clerk.com → Users → click your user
ALLOWED_CLERK_IDS=user_abc123,user_xyz456

# ── SERVER ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ───────────────────────────────────────────────
# Your Vercel frontend URL (set after deploying frontend)
FRONTEND_URL=http://localhost:3000

# ── SMS (add when ready) ───────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── EMAIL (add when ready) ─────────────────────────────
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM_EMAIL=newsletter@impacthouse.org
# SENDGRID_FROM_NAME=Impact House Church
